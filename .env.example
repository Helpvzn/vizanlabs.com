# GitHub OAuth (for CMS login)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Cashfree webhook signing secret
# Get this from: Cashfree Dashboard → Developers → Webhooks → Secret Key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# Resend.com for emails (free tier: 100/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ── Cloudflare Bindings (set in Cloudflare Pages dashboard, NOT .env) ──
# KV Namespace  → name: PDF_ORDERS
# R2 Bucket     → name: PDF_BUCKET  (private, no public access)
